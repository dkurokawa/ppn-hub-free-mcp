{
  "name": "ppn-hub-free-mcp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Keyless read-only MCP entry point for PPN Hub — a thin rate-limited proxy in front of mcp.ppn-hub.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dkurokawa/ppn-hub-free-mcp"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "gen-allowlist": "node scripts/gen-allowlist.mjs"
  },
  "dependencies": {
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260116.0",
    "@eslint/js": "^9.19.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.21.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.59.0"
  }
}
